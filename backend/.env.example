# Server Port (Render sets this automatically in production)
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rolloutguard?retryWrites=true&w=majority

# Frontend URL for CORS (e.g., https://your-project.vercel.app)
CLIENT_URL=http://localhost:5173

# Fallback in-memory database mode: 'auto' | 'true' | 'false'
USE_IN_MEMORY_DB=auto
